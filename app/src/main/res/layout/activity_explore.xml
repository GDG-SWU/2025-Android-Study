<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- 제목 -->
    <TextView
        android:id="@+id/tv_explore_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Find Products"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:layout_marginBottom="16dp" />

    <!-- 검색창 -->
    <androidx.appcompat.widget.SearchView
        android:id="@+id/search_view_explore"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:queryHint="Search Store"
        android:iconifiedByDefault="false"
        android:background="@drawable/search_bg"
        android:layout_marginBottom="24dp"/>

    <!-- 카테고리 그리드 -->
    <GridLayout
        android:id="@+id/grid_categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="3"
        android:alignmentMode="alignMargins"
        android:rowOrderPreserved="false"
        android:columnOrderPreserved="false"
        android:layout_marginBottom="16dp">

        <!-- 카테고리 아이템 예시 -->
        <LinearLayout
            android:id="@+id/category_fruits"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:background="@drawable/category_bg_green"
            android:gravity="center"
            android:padding="8dp"
            android:layout_margin="8dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_fruits"
                android:contentDescription="Fruits &amp; Vegetable"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frash Fruits &amp; Vegetable"
                android:textSize="14sp"
                android:textColor="#222222"
                android:gravity="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/category_oil"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:background="@drawable/category_bg_orange"
            android:gravity="center"
            android:padding="8dp"
            android:layout_margin="8dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_oil"
                android:contentDescription="Cooking Oil &amp; Ghee"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cooking Oil &amp; Ghee"
                android:textSize="14sp"
                android:textColor="#222222"
                android:gravity="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Meat & Fish -->
        <LinearLayout
            android:id="@+id/category_meat"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:background="@drawable/category_bg_red"
            android:gravity="center"
            android:padding="8dp"
            android:layout_margin="8dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_meat"
                android:contentDescription="Meat &amp; Fish"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meat &amp; Fish"
                android:textSize="14sp"
                android:textColor="#222222"
                android:gravity="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Bakery & Snacks -->
        <LinearLayout
            android:id="@+id/category_bakery"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:background="@drawable/category_bg_purple"
            android:gravity="center"
            android:padding="8dp"
            android:layout_margin="8dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_bakery"
                android:contentDescription="Bakery &amp; Snacks"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bakery &amp; Snacks"
                android:textSize="14sp"
                android:textColor="#222222"
                android:gravity="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Dairy & Eggs -->
        <LinearLayout
            android:id="@+id/category_dairy"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:background="@drawable/category_bg_yellow"
            android:gravity="center"
            android:padding="8dp"
            android:layout_margin="8dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_eggs"
                android:contentDescription="Dairy &amp; Eggs"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dairy &amp; Eggs"
                android:textSize="14sp"
                android:textColor="#222222"
                android:gravity="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Beverages -->
        <LinearLayout
            android:id="@+id/category_beverages"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:background="@drawable/category_bg_blue"
            android:gravity="center"
            android:padding="8dp"
            android:layout_margin="8dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_beverages"
                android:contentDescription="Beverages"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beverages"
                android:textSize="14sp"
                android:textColor="#222222"
                android:gravity="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

    </GridLayout>

</LinearLayout>