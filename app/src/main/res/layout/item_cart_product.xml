<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/img_cart_product"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/bell_pepper_red"
        android:scaleType="fitCenter"
        android:contentDescription="장바구니 상품 이미지"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_cart_product_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Bell Pepper Red"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@+id/img_cart_product"
        app:layout_constraintStart_toEndOf="@+id/img_cart_product"
        app:layout_constraintEnd_toStartOf="@+id/btn_remove_item" />

    <TextView
        android:id="@+id/text_cart_product_unit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="1kg, Priceg"
        android:textColor="@color/nectar_gray_text"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@+id/text_cart_product_name"
        app:layout_constraintStart_toStartOf="@+id/text_cart_product_name"
        app:layout_constraintEnd_toEndOf="@+id/text_cart_product_name" />

    <LinearLayout
        android:id="@+id/layout_quantity_control"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/text_cart_product_unit"
        app:layout_constraintStart_toStartOf="@+id/text_cart_product_name"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btn_cart_minus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_minus"
            android:background="@drawable/bg_quantity_circle"
            android:contentDescription="수량 감소" />

        <TextView
            android:id="@+id/text_cart_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:textSize="16sp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <ImageButton
            android:id="@+id/btn_cart_plus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_add"
            android:background="@drawable/bg_quantity_circle"
            android:contentDescription="수량 증가" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_cart_item_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$4.99"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/layout_quantity_control"
        app:layout_constraintBottom_toBottomOf="@+id/layout_quantity_control" />

    <ImageButton
        android:id="@+id/btn_remove_item"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_remove"
        android:background="@android:color/transparent"
        android:contentDescription="상품 삭제"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E2E2E2"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/img_cart_product"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>