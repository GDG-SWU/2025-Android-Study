<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeScreen">

    <!-- 상단 고정 영역 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_fixed_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 로고, 위치 정보 배치 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/top_info_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 중앙 당근 로고 -->
            <ImageView
                android:id="@+id/img_header_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/homescreen_logo"
                android:contentDescription="Homescreen Logo"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <!-- 위치  -->
            <ImageView
                android:id="@+id/img_location_combined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/location"
                android:contentDescription="Location"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/img_header_logo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- 검색창 -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/search"
            android:contentDescription="Search Store"
            android:scaleType="fitXY"
            app:layout_constraintTop_toBottomOf="@id/top_info_area"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 스크롤 영역  -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_fixed_layout"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_fixed_layout">

        <!-- 컨테이너 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Exclusive Offer 섹션 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <!-- Exclusive Offer 문구 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exclusive_offer"
                    android:textColor="#181725"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    />

                <!-- See all 문구 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/see_all"
                    android:textColor="#53B175"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Exclusive Offer 목록 가로 스크롤 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <!-- 3칸을 수평으로 나열 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <ImageView
                        android:layout_width="175dp"
                        android:layout_height="250dp"
                        android:src="@drawable/banana_card"
                        android:contentDescription="Banana Product Image"
                        android:scaleType="fitXY"
                        android:layout_marginEnd="16dp" />

                    <ImageView
                        android:layout_width="175dp"
                        android:layout_height="250dp"
                        android:src="@drawable/apple"
                        android:contentDescription="Apple Product Image"
                        android:scaleType="fitXY"
                        android:layout_marginEnd="16dp" />

                    <ImageView
                        android:layout_width="175dp"
                        android:layout_height="250dp"
                        android:src="@drawable/banana_card"
                        android:contentDescription="Banana Product Image"
                        android:scaleType="fitXY" />

                </LinearLayout>

            </HorizontalScrollView>



            <!-- Best Selling 섹션 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <!-- Best Selling 문구 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/best_selling"
                    android:textColor="#181725"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    />

                <!-- See all 문구 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/see_all"
                    android:textColor="#53B175"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Best Selling 목록 가로 스크롤) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <!-- 3칸 수평으로 나열 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <ImageView
                        android:layout_width="175dp"
                        android:layout_height="250dp"
                        android:src="@drawable/bellpepperred"
                        android:contentDescription="Bell Pepper Red Image"
                        android:scaleType="fitXY"
                        android:layout_marginEnd="16dp" />

                    <ImageView
                        android:layout_width="175dp"
                        android:layout_height="250dp"
                        android:src="@drawable/ginger"
                        android:contentDescription="Ginger Product Image"
                        android:scaleType="fitXY"
                        android:layout_marginEnd="16dp" />

                    <ImageView
                        android:layout_width="175dp"
                        android:layout_height="250dp"
                        android:src="@drawable/bellpepperred"
                        android:contentDescription="Bell Pepper Red Image"
                        android:scaleType="fitXY" />

                </LinearLayout>

            </HorizontalScrollView>

            <!-- Groceries 섹션 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <!-- Groceries 문구 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/groceries_title"
                    android:textColor="#181725"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    />

                <!-- See all 문구 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/see_all"
                    android:textColor="#53B175"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Pulses&Rice 가로 스크롤 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <!-- 수평으로 나열 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="100dp"
                        android:src="@drawable/pulses"
                        android:contentDescription="Pulses Category Image"
                        android:scaleType="fitXY"
                        android:layout_marginEnd="16dp" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="100dp"
                        android:src="@drawable/rice"
                        android:contentDescription="Rice Category Image"
                        android:scaleType="fitXY"
                        android:layout_marginEnd="16dp" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="100dp"
                        android:src="@drawable/pulses"
                        android:contentDescription="Pulses Category Image"
                        android:scaleType="fitXY" />

                </LinearLayout>

            </HorizontalScrollView>

            <!-- Beef Bone&Chicken 가로 스크롤 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <!-- 수평으로 나열 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:layout_width="175dp"
                        android:layout_height="250dp"
                        android:src="@drawable/beef_bone"
                        android:contentDescription="Beef Bone Product Image"
                        android:scaleType="fitXY"
                        android:layout_marginEnd="16dp" />

                    <FrameLayout
                        android:layout_width="175dp"
                        android:layout_height="250dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/chicken"
                            android:contentDescription="Chicken Product Card"
                            android:scaleType="fitXY" />

                        <ImageView
                            android:layout_width="120dp"
                            android:layout_height="100dp"
                            android:src="@drawable/pngfuel"
                            android:contentDescription="Raw Chicken Image"
                            android:scaleType="fitCenter"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="16dp" />

                    </FrameLayout>

                    <ImageView
                        android:layout_width="175dp"
                        android:layout_height="250dp"
                        android:src="@drawable/beef_bone"
                        android:contentDescription="Beef Bone Product Image"
                        android:scaleType="fitXY" />

                </LinearLayout>

            </HorizontalScrollView>


        </LinearLayout>
    </ScrollView>

    <!-- ============================================== -->
    <!-- 하단 바 고정 -->
    <ImageView
        android:id="@+id/bottom_nav_fixed_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/bottom_bar"
        android:contentDescription="Bottom Bar"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>